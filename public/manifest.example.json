{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "_comment": "참고용 정적 예시입니다. 실제 서비스는 /manifest.json · /manifest.webmanifest (관리자 PWA 설정 반영) 를 사용합니다.",
  "id": "/?pwa=v3",
  "name": "앱 이름 (전체)",
  "short_name": "짧은 이름",
  "description": "앱 이름 — 홈 화면에 추가해 앱처럼 사용할 수 있습니다.",
  "start_url": "https://chu-p.kro.kr/",
  "scope": "https://chu-p.kro.kr/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#059669",
  "lang": "ko",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [],
  "categories": ["utilities", "productivity"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "icons": [
    {
      "src": "https://example.com/pwa/app-icon.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://example.com/pwa/app-icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://example.com/pwa/app-icon.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://example.com/pwa/app-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://example.com/pwa/app-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
